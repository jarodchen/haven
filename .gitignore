# Eleventy 静态站的依赖与产物：由构建生成，不入库
node_modules/
dist/
build/
public/
.cache/
_site/
npm-debug.log*
yarn-error.log*

# 构建时下载的 Obsidian 主题副本、插件槽位同步副本
src/site/styles/theme.*.css
src/site/styles/_theme.*.css
src/site/_includes/plugins/

# 其他部署平台的本地目录（本站用 GitHub Pages，这几个只会误伤）
.netlify
.vercel

# .env 与 package-lock.json 必须入库：CI 的 npm ci 和 Eleventy 构建都要读它们。
# 站点凭据不存在本仓库里——GitHub Token 只写在 Obsidian 插件配置中，而那已不在此库。

# 编辑器与操作系统垃圾
.idea/
.vscode/
*.swp
*.tmp
*~
~$*
.DS_Store
**/.DS_Store
._*
Thumbs.db
desktop.ini
